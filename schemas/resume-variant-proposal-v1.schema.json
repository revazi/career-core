{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/revazi/career-core/main/schemas/resume-variant-proposal-v1.schema.json",
  "title": "career-core assisted resume variant proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "changes"],
  "properties": {
    "schema_version": {
      "const": "career.resume_variant_proposal.v1"
    },
    "changes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/proposedChange"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "string",
      "enum": [
        "contact",
        "summary",
        "experience",
        "education",
        "skills",
        "projects",
        "certifications",
        "other"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "proposedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "start_line",
        "end_line",
        "original_text",
        "proposed_text",
        "resume_evidence",
        "vacancy_evidence"
      ],
      "properties": {
        "section": {
          "$ref": "#/$defs/section"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "original_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "proposed_text": {
          "type": "string",
          "maxLength": 10000
        },
        "resume_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "vacancy_evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
