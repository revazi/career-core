{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/revazi/career-core/main/schemas/resume-variant-materialization-input-v1.schema.json",
  "title": "career-core assisted resume variant materialization input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_review_policy_version",
    "review_input",
    "selected_change_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "career.resume_variant_materialization_input.v1"
    },
    "expected_review_policy_version": {
      "const": "resume_variant_review_v1"
    },
    "review_input": {
      "$ref": "resume-variant-review-input-v1.schema.json"
    },
    "selected_change_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^change-[0-9]{4}$"
      }
    }
  }
}
