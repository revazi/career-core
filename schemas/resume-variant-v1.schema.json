{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/revazi/career-core/main/schemas/resume-variant-v1.schema.json",
  "title": "career-core assisted resume variant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "core_version",
    "authority",
    "baseline_resume",
    "assisted_resume_text",
    "selected_changes",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "career.resume_variant.v1"
    },
    "policy_version": {
      "const": "resume_variant_review_v1"
    },
    "core_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority": {
      "const": "assisted_non_authoritative"
    },
    "baseline_resume": {
      "$ref": "resume-input-v1.schema.json"
    },
    "assisted_resume_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "selected_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "resume-variant-review-v1.schema.json#/$defs/canonicalChange"
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "resume-variant-review-v1.schema.json#/$defs/warning"
      }
    }
  }
}
