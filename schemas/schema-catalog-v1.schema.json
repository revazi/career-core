{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/revazi/career-core/main/schemas/schema-catalog-v1.schema.json",
  "title": "career CLI schema catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schemas"],
  "properties": {
    "schema_version": {
      "const": "career.schema_catalog.v1"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file_name", "title"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^career\\.[a-z0-9_]+\\.v[1-9][0-9]*$",
            "maxLength": 100
          },
          "file_name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+-v[1-9][0-9]*\\.schema\\.json$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  }
}
