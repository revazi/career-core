{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/revazi/career-core/main/schemas/resume-analysis-replacement-review-v1.schema.json",
  "title": "career-core reviewed external resume analysis replacements v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "analysis_policy_version",
    "core_version",
    "authority",
    "baseline_analysis",
    "replacements",
    "discarded_replacements",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "career.resume_analysis_replacement_review.v1"
    },
    "policy_version": {
      "const": "resume_analysis_replacement_review_v1"
    },
    "analysis_policy_version": {
      "const": "resume_analysis_v1"
    },
    "core_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority": {
      "const": "assisted_non_authoritative"
    },
    "baseline_analysis": {
      "$ref": "resume-analysis-v1.schema.json"
    },
    "replacements": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/canonicalReplacement"
      }
    },
    "discarded_replacements": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/discardedReplacement"
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "canonicalReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement_id",
        "priority",
        "area",
        "basis_check_id",
        "status",
        "improvement_action",
        "start_line",
        "end_line",
        "source_target",
        "source_evidence",
        "proposed_replacement"
      ],
      "properties": {
        "replacement_id": {
          "type": "string",
          "pattern": "^replacement-[0-9]{4}$"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "area": {
          "$ref": "resume-analysis-v1.schema.json#/$defs/category"
        },
        "basis_check_id": {
          "$ref": "resume-analysis-v1.schema.json#/$defs/checkId"
        },
        "status": {
          "enum": ["confirmed", "provisional"]
        },
        "improvement_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "source_target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "proposed_replacement": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "discardedReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_index", "code"],
      "properties": {
        "input_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_line_range",
            "target_mismatch",
            "invalid_target",
            "no_change",
            "replacement_too_long",
            "unsupported_control_character",
            "invalid_source_evidence",
            "basis_action_not_current",
            "duplicate_or_overlapping_target",
            "duplicate_basis_action"
          ]
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "assisted_replacements_non_authoritative",
            "evidence_occurrence_not_factual_or_rewrite_certification",
            "deterministic_analysis_preserved"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  }
}
