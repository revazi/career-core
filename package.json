{
  "name": "career-core-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Local Pi tools and canonical Agent Skill for the installed deterministic career CLI",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
