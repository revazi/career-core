{
  "name": "@revazi/career-darwin-x64",
  "version": "0.1.1",
  "private": true,
  "description": "Internal Career Core CLI implementation for Intel macOS",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revazi/career-core.git"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "career",
    "provenance.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "career_native": {
    "schema_version": "career.npm_native_package.v2",
    "platform_key": "darwin-x64",
    "node_platform": "darwin",
    "node_arch": "x64",
    "libc_family": null,
    "rust_target": "x86_64-apple-darwin",
    "binary_file": "career",
    "provenance_file": "provenance.json",
    "binary_format": "mach-o-64-x86_64",
    "binary_architecture": "x86_64",
    "file_invariant": "unix_regular_non_symlink_mode_0755",
    "archive_mode": "0755",
    "executable_mode": "0755",
    "maximum_binary_size_bytes": 16777216,
    "minimum_glibc_version": null
