{
  "name": "@revazi/career-linux-arm64-musl",
  "version": "0.2.0",
  "private": true,
  "description": "Internal Career Core CLI implementation for ARM64 musl Linux",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revazi/career-core.git"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64"
  ],
  "libc": [
    "musl"
  ],
  "files": [
    "career",
    "provenance.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "career_native": {
    "schema_version": "career.npm_native_package.v2",
    "platform_key": "linux-arm64-musl",
    "node_platform": "linux",
    "node_arch": "arm64",
    "libc_family": "musl",
    "rust_target": "aarch64-unknown-linux-musl",
    "binary_file": "career",
    "provenance_file": "provenance.json",
    "binary_format": "elf-64-aarch64",
    "binary_architecture": "aarch64",
    "file_invariant": "unix_regular_non_symlink_mode_0755",
    "archive_mode": "0755",
    "executable_mode": "0755",
    "maximum_binary_size_bytes": 16777216,
    "minimum_glibc_version": null
  }
}
