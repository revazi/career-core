{
  "name": "@revazi/career",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic local Career Core CLI for resume evaluation and job matching",
  "license": "MIT OR Apache-2.0",
  "author": "Revaz Zakalashvili",
  "homepage": "https://github.com/revazi/career-core#readme",
  "bugs": {
    "url": "https://github.com/revazi/career-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revazi/career-core.git"
  },
  "keywords": [
    "career",
    "resume",
    "job-search",
    "matching",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "career": "bin/career.js"
  },
  "files": [
    "bin/career.js",
    "targets.json",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "optionalDependencies": {
    "@revazi/career-darwin-arm64": "0.2.0",
    "@revazi/career-darwin-x64": "0.2.0",
    "@revazi/career-linux-x64-gnu": "0.2.0",
    "@revazi/career-linux-arm64-gnu": "0.2.0",
    "@revazi/career-linux-x64-musl": "0.2.0",
    "@revazi/career-linux-arm64-musl": "0.2.0"
  },
  "career_launcher": {
    "schema_version": "career.npm_launcher.v2",
    "executable": "career",
    "target_catalog": "targets.json",
    "platform_packages": [
      "@revazi/career-darwin-arm64",
      "@revazi/career-darwin-x64",
      "@revazi/career-linux-x64-gnu",
      "@revazi/career-linux-arm64-gnu",
      "@revazi/career-linux-x64-musl",
      "@revazi/career-linux-arm64-musl"
    ]
  }
}
